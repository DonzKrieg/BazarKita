APP_NAME=BazarKita
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# Tahap frontend: tidak memerlukan database, worker, atau provider.
APP_MAINTENANCE_DRIVER=file
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
VITE_APP_NAME="${APP_NAME}"
